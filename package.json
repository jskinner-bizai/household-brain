{
  "name": "household-brain",
  "version": "0.2.0",
  "description": "Household Brain: shared pantry, groceries, meals, chores and brief tools in a self-hosted MCP server built for the Alexa+ track",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "household-brain": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc -w",
    "test": "tsc && node --test dist/test/*.test.js",
    "demo": "npm run build && node scripts/demo.mjs"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1156.0",
    "@aws-sdk/credential-providers": "3.1156.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
